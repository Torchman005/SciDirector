      "source": "internal",
      "code": "<svg id='ambient' viewBox='0 0 1920 1080' width='1920' height='1080'><rect width='1920' height='1080' fill='#0B1020'/><circle id='glow' cx='960' cy='540' r='340' fill='#4F8CFF' opacity='.12'/><text id='title' x='960' y='540' text-anchor='middle' dominant-baseline='middle' font-size='64' fill='#E6ECFF'>从问题出发，看见变化</text><rect id='accent' x='600' y='640' width='0' height='6' rx='3' fill='#4F8CFF'/></svg><script>const DUR=8;const glow=document.getElementById('glow'),title=document.getElementById('title'),accent=document.getElementById('accent');window.__seek=(t)=>{const p=Math.max(0,Math.min(1,t/DUR));glow.setAttribute('cx',String(840+240*p));glow.setAttribute('opacity',String(.12+.03*Math.sin(p*Math.PI*2)));title.setAttribute('opacity',String(Math.min(1,p*5)));accent.setAttribute('width',String(720*Math.min(1,p*2)));};window.__seek(0);window.__ready=true;</script>"
    }
