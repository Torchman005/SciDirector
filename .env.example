# =============================================================================
# SciDirector 环境变量模板 —— 复制为 .env 后按需修改
#   cp .env.example .env
# 注意：.env 已被 .gitignore 忽略，禁止把真实密钥提交进仓库。
# =============================================================================

# ---------- 运行环境 ----------
SCID_ENV=dev
SCID_LOG_LEVEL=info
SCID_TRACE_SAMPLE_RATIO=1.0

# ---------- 端口 ----------
SCID_API_PORT=8080
SCID_AI_GRPC_PORT=50051
SCID_AI_HTTP_PORT=8000
SCID_WEB_PORT=5173
SCID_REDIS_PORT=6379
SCID_PG_PORT=5432
# 对象存储（RustFS）在宿主机上的端口：9000 = S3 API，9001 = 控制台。
# 若宿主机上 5432 已被别的 Postgres 占用（很常见），把 SCID_PG_PORT 改掉即可，
# 同时记得同步下面的 SCID_POSTGRES_DSN。
SCID_S3_PORT=9000
SCID_S3_CONSOLE_PORT=9001

# ---------- Redis ----------
SCID_REDIS_ADDR=localhost:6379
SCID_REDIS_PASSWORD=
SCID_REDIS_DB=0

# ---------- Postgres ----------
SCID_PG_USER=scidirector
SCID_PG_PASSWORD=scidirector
SCID_PG_DB=scidirector
SCID_POSTGRES_DSN=postgres://scidirector:scidirector@localhost:5432/scidirector?sslmode=disable

# ---------- 对象存储（S3 兼容：RustFS） ----------
#
# 这一组是 **Go 侧真正读取** 的变量名（原先后端只读 SCID_MINIO_*，
# 而本文件写的是 SCID_S3_* —— 照着这里配根本不生效，是一处静默错配，已修正）。
#
# 旧名 SCID_MINIO_* 仍被接受为**兼容回退**（新名优先），
# 老部署的 .env 不必改也不会失效；但新配置请一律用 SCID_S3_*。
SCID_S3_ENDPOINT=http://localhost:9000
SCID_S3_ACCESS_KEY=scidirector
SCID_S3_SECRET_KEY=scidirector-secret
SCID_S3_BUCKET=scidirector-artifacts
SCID_S3_USE_SSL=false

# ---------- Go Worker ----------
SCID_WORKER_CONCURRENCY=4
SCID_FFMPEG_BIN=ffmpeg
SCID_FFPROBE_BIN=ffprobe
SCID_FFMPEG_MAX_PARALLEL=4
SCID_MEDIA_WORK_DIR=./.data/work
SCID_MEDIA_KEEP_INTERMEDIATE=true
SCID_JOB_MAX_ATTEMPTS=3

# ---------- gRPC 客户端（Go -> Python） ----------
SCID_AI_GRPC_ADDR=localhost:50051
SCID_AI_GRPC_TIMEOUT_SEC=900
SCID_AI_GRPC_STREAM_TIMEOUT_SEC=3600

# ---------- LLM / VLM（Python 侧） ----------
SCID_LLM_PROVIDER=openai
SCID_LLM_MODEL=gpt-4o
SCID_VLM_MODEL=gpt-4o
SCID_LLM_TEMPERATURE=0.2
OPENAI_API_KEY=
# 兼容 OpenAI 协议的国产/自建网关，例如智谱、DeepSeek、vLLM
OPENAI_BASE_URL=

# ---------- 沙盒 ----------
SCID_SANDBOX_TIMEOUT_SEC=180
SCID_SANDBOX_MAX_MEMORY_MB=2048
SCID_SANDBOX_MAX_CPU_SEC=240
SCID_SANDBOX_PYTHON_BIN=python
SCID_SANDBOX_MANIM_QUALITY=l   # l=480p 草稿, m=720p, h=1080p

# ---------- 渲染与合成 ----------
SCID_RENDER_FPS=30
SCID_RENDER_WIDTH=1920
SCID_RENDER_HEIGHT=1080
SCID_CRITIC_SCORE_THRESHOLD=0.75
SCID_SHOT_MAX_ATTEMPTS=3

# ---------- 前端 ----------
VITE_API_BASE=http://localhost:8080
VITE_WS_BASE=ws://localhost:8080
